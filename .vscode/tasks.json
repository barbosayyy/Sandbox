{
    "tasks": [
        {
            "type": "shell",
            "label": "Sandbox: Clean build",
            "command": "rm -r ${workspaceFolder}/build",
            "problemMatcher": [],
            "detail": "Clean the Sandbox build folder"
        },
        {
            "type": "shell",
            "label": "Sandbox: Clean CMake cache",
            "command": "rm -r ${workspaceFolder}/.cache",
            "problemMatcher": [],
            "detail": "Clean CMake .cache folder"
        },
        {
            "type": "shell",
            "label": "Sandbox: Set Build Editor ON",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=ON -G Ninja",
            "problemMatcher": [],
            "detail": "Set Build Editor ON in cache"
        },
        {
            "type": "shell",
            "label": "Sandbox: Set Build Editor OFF",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=OFF -G Ninja",
            "problemMatcher": [],
            "detail": "Sets Build Editor OFF in cache"
        },
    ]
}