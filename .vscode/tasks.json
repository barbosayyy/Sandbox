{
    "tasks": [
        {
            "type": "shell",
            "label": "Sandbox: Clean build",
            "windows": {
                "command": "rm -r ${workspaceFolder}/build"
            },
            "osx": {
                "command": "rm -rf ${workspaceFolder}/build"
            },
            "linux": {
                "command": "rm -rf ${workspaceFolder}/build"
            },
            "problemMatcher": [],
            "detail": "Clean the Sandbox build folder"
        },
        {
            "type": "shell",
            "label": "Sandbox: Clean CMake cache",
            "windows": {
                "command": "rm -r ${workspaceFolder}/.cache"
            },
            "osx": {
                "command": "rm -rf ${workspaceFolder}/.cache"
            },
            "linux": {
                "command": "rm -rf ${workspaceFolder}/.cache"
            },
            "problemMatcher": [],
            "detail": "Clean CMake .cache folder"
        },
        {
            "type": "shell",
            "label": "Sandbox: Set Build Editor ON",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=ON -G Ninja",
            "problemMatcher": [],
            "detail": "Set Build Editor ON in cache"
        },
        {
            "type": "shell",
            "label": "Sandbox: Set Build Editor OFF",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=OFF -G Ninja",
            "problemMatcher": [],
            "detail": "Sets Build Editor OFF in cache"
        },
        {
            "type": "shell",
            "label": "Sandbox: Set Build Game ON",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_GAME=ON -G Ninja",
            "problemMatcher": [],
            "detail": "Set Build Game ON in cache"
        },
        {
            "type": "shell",
            "label": "Sandbox: Set Build Game OFF",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_GAME=OFF -G Ninja",
            "problemMatcher": [],
            "detail": "Sets Build Game OFF in cache"
        },
        {
            "type": "shell",
            "label": "Sandbox: Build Editor & Game",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=ON -G Ninja --DCMAKE_BUILD_TYPE=Debug; cmake --build ${workspaceFolder}/build --config Debug --target all",
            "problemMatcher": [],
            "detail": "Build Editor and Game executables"
        },
        {
            "type": "shell",
            "label": "Sandbox: Build Editor & Game Release",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=ON -G Ninja -DCMAKE_BUILD_TYPE=Release; cmake --build ${workspaceFolder}/build --config Release --target all",
            "problemMatcher": [],
            "detail": "Build Editor and Game executables"
        },
        {
            "type": "shell",
            "label": "Sandbox: Build Game",
            "command": "cmake -B ${workspaceFolder}/build -DBUILD_EDITOR=OFF -G Ninja; cmake --build ${workspaceFolder}/build --config Debug --target all",
            "problemMatcher": [],
            "detail": "Build Game executable"
        },
        {
            "type": "shell",
            "label": "Check/Install required extensions",
            "command": "${workspaceFolder}/scripts/check_extensions.ps1"
        },
    ]
}